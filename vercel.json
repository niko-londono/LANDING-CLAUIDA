{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "landing-clauida.vercel.app" }],
      "destination": "https://landing-claudia.vercel.app/",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "landing-clauida.vercel.app" }],
      "destination": "https://landing-claudia.vercel.app/:path*",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/assets/(img|secuencia|fonts)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/(css|js)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
